# Lấy 2 giá trị này ở Supabase Dashboard > Settings > API
# anon key AN TOÀN để đưa vào FE (kể cả public repo) — xem giải thích trong
# src/supabaseClient.js. KHÔNG bao giờ đặt service_role key ở đây.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Tùy chọn) Hiện các nút dọn/xóa dữ liệu kiểm thử. Mặc định KHÔNG đặt = ẨN
# (dùng khi demo cho người ngoài xem). Đặt 1 rồi build lại để hiện lại các nút.
# VITE_HIEN_NUT_KIEM_THU=1
