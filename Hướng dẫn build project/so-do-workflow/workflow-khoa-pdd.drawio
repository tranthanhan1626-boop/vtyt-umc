<mxfile host="app.diagrams.net" modified="2026-08-16T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false"><diagram id="overview" name="01 Tổng quan Khoa ↔ PĐD"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3040" pageHeight="2060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane-khoa" value="KHOA / ĐƠN VỊ SỬ DỤNG" style="swimlane;horizontal=1;startSize=54;rounded=1;arcSize=12;html=1;fillColor=#F0FDFA;swimlaneFillColor=#F0FDFA;strokeColor=#99F6E4;fontColor=#115E59;fontSize=18;fontStyle=1;strokeWidth=2;collapsible=0;pointerEvents=0;locked=1;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="1370" height="1660" as="geometry"/></mxCell><mxCell id="lane-pdd" value="PHÒNG ĐIỀU DƯỠNG (PĐD)" style="swimlane;horizontal=1;startSize=54;rounded=1;arcSize=12;html=1;fillColor=#F8FAFF;swimlaneFillColor=#F8FAFF;strokeColor=#BFDBFE;fontColor=#1E40AF;fontSize=18;fontStyle=1;strokeWidth=2;collapsible=0;pointerEvents=0;locked=1;" vertex="1" parent="1"><mxGeometry x="1510" y="210" width="1470" height="1660" as="geometry"/></mxCell><mxCell id="p0" value="&lt;b&gt;1. Khởi tạo vòng&lt;/b&gt;&lt;br&gt;Tạo / mở đợt đề xuất&lt;br&gt;Khi vận hành chọn đúng gói con" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1600" y="280" width="390" height="112" as="geometry"/></mxCell><mxCell id="k0" value="&lt;b&gt;2. Vào đúng phạm vi&lt;/b&gt;&lt;br&gt;Chọn đợt + gói con&lt;br&gt;Khóa logic cần là dot_id × goi_id" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="280" width="390" height="112" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;3. Lập số ở cấp mã quản lý&lt;/b&gt;&lt;br&gt;Chọn ĐVT chuẩn + hệ số quy đổi&lt;br&gt;TSB 24 tháng → P50 / P75 / P90 / P95" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="465" width="390" height="138" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;4. Chốt tổng &amp;amp; phân bổ&lt;/b&gt;&lt;br&gt;Chốt tổng mã quản lý&lt;br&gt;Phân bổ xuống mã hàng; tổng quy đổi phải khớp" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="585" y="465" width="390" height="138" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;5. Giỏ bền vững&lt;/b&gt;&lt;br&gt;Thêm cả mã quản lý&lt;br&gt;Lưu server; account cùng Khoa dùng chung" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="465" width="330" height="138" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b&gt;6. Gửi giỏ = chính thức&lt;/b&gt;&lt;br&gt;1 transaction · 1 giỏ = 1 gói con&lt;br&gt;KHÔNG có bước PĐD duyệt giỏ" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="680" width="330" height="142" as="geometry"/></mxCell><mxCell id="k5" value="&lt;b&gt;7. Danh mục Khoa / KHOA_READY&lt;/b&gt;&lt;br&gt;Tạo Word cam kết ngay&lt;br&gt;Sửa ô + audit; chốt/mở là checkpoint riêng" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="585" y="680" width="390" height="142" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;8. Bàn điều hành PĐD&lt;/b&gt;&lt;br&gt;Theo dõi 62 Khoa: đề xuất / Word / chốt&lt;br&gt;Mở danh mục từng Khoa; nhắc hoàn tất" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1600" y="680" width="390" height="142" as="geometry"/></mxCell><mxCell id="scopeGap" value="&lt;b&gt;LỆCH PHẠM VI TRIỂN KHAI CẦN ƯU TIÊN&lt;/b&gt;&lt;br&gt;Nghiệp vụ cần Đợt × Gói con. Hiện bảng chốt chỉ khóa dot_id; override PĐD tự ghép goi_id:dot:dot_id,&lt;br&gt;trong khi view và màn Khoa còn đọc goi_id tĩnh → có nguy cơ chốt cả 5 gói con hoặc lệch số hiển thị." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1600" y="450" width="1260" height="155" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;9. Danh mục tổng hợp&lt;/b&gt;&lt;br&gt;Cộng theo mã hàng trong đúng đợt + gói con&lt;br&gt;Sổ xuống xem đóng góp từng Khoa" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2035" y="680" width="390" height="142" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;10. Hiệu chỉnh &amp;amp; hồ sơ&lt;/b&gt;&lt;br&gt;PĐD sửa / khóa + audit&lt;br&gt;Xuất Excel tổng hợp + Word đề nghị mua" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2470" y="680" width="390" height="142" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;11. Đấu thầu — 3 giai đoạn&lt;/b&gt;&lt;br&gt;Chào giá → Mở thầu → Đánh giá&lt;br&gt;Chỉ tích RỚT; không tích = mặc định TRÚNG" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2470" y="905" width="390" height="142" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Kết quả mã?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7C2D12;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2170" y="920" width="190" height="120" as="geometry"/></mxCell><mxCell id="k6" value="&lt;b&gt;Rớt 1 phần&lt;/b&gt;&lt;br&gt;Khoa nhận thông báo&lt;br&gt;Đẩy SL sang mã tương đương còn trúng&lt;br&gt;Giữ nguyên tổng mã quản lý" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="1055" width="410" height="155" as="geometry"/></mxCell><mxCell id="k7" value="&lt;b&gt;Rớt hoàn toàn&lt;/b&gt;&lt;br&gt;Vào giỏ rớt&lt;br&gt;Chọn đợt bổ sung đang mở" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="1055" width="410" height="155" as="geometry"/></mxCell><mxCell id="k8" value="&lt;b&gt;Vòng bổ sung&lt;/b&gt;&lt;br&gt;Chuyển vào giỏ server&lt;br&gt;Chỉnh số → gửi chính thức" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1060" y="1055" width="290" height="155" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;12. Một cờ chốt đang gánh 2 mốc&lt;/b&gt;&lt;br&gt;UI: chốt số đi thầu; tài liệu: chốt sau thầu&lt;br&gt;DB chưa có RESULT_FINALIZED riêng&lt;br&gt;Hiện chốt dot_id, rộng hơn một gói con 18T" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2020" y="1185" width="430" height="170" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;13. Hợp đồng &amp;amp; hàng về&lt;/b&gt;&lt;br&gt;Ký hợp đồng&lt;br&gt;Đánh dấu hàng về đợt đầu" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2500" y="1190" width="360" height="155" as="geometry"/></mxCell><mxCell id="k9" value="&lt;b&gt;14. Sau đấu thầu&lt;/b&gt;&lt;br&gt;Xem kết quả; xác nhận đã xem&lt;br&gt;Mua thêm ≤ floor(30%) sau khi đúng đợt đã chốt" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="1365" width="410" height="155" as="geometry"/></mxCell><mxCell id="k10" value="&lt;b&gt;15. Sử dụng &amp;amp; phản hồi&lt;/b&gt;&lt;br&gt;Sổ thiếu hàng&lt;br&gt;Sự kiện nhu cầu / mã kỹ thuật mới" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="1365" width="410" height="155" as="geometry"/></mxCell><mxCell id="p7" value="&lt;b&gt;16. Giám sát toàn viện&lt;/b&gt;&lt;br&gt;Nạp HIS; chỉnh ngưỡng cam kết&lt;br&gt;4 tầng: gói → MQ → mã hàng → Khoa&lt;br&gt;Tách cảnh báo chậm / sắp hết sớm" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1600" y="1365" width="430" height="170" as="geometry"/></mxCell><mxCell id="p8" value="&lt;b&gt;17. Can thiệp&lt;/b&gt;&lt;br&gt;Theo dõi giỏ rớt toàn viện; nhắc Khoa&lt;br&gt;Sắp hết sớm → mở đợt bổ sung" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2080" y="1380" width="390" height="140" as="geometry"/></mxCell><mxCell id="k11" value="&lt;b&gt;Các luồng hỗ trợ Khoa → PĐD&lt;/b&gt;&lt;br&gt;Báo thiếu hàng · khai sự kiện nhu cầu&lt;br&gt;Đề nghị mã kỹ thuật / sửa tiêu chí" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="1610" width="500" height="135" as="geometry"/></mxCell><mxCell id="gap1" value="&lt;b&gt;Khoảng trống đã biết&lt;/b&gt;&lt;br&gt;PĐD sửa tổng toàn viện: Khoa thấy số + audit,&lt;br&gt;nhưng chưa có thuật toán chia ngược vào proposal từng Khoa." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="1595" width="650" height="165" as="geometry"/></mxCell><mxCell id="p9" value="&lt;b&gt;PĐD tiếp nhận / duyệt / trả lại&lt;/b&gt;&lt;br&gt;Xử lý thiếu hàng&lt;br&gt;Duyệt hoặc từ chối sự kiện, mã kỹ thuật, tiêu chí" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1600" y="1610" width="500" height="135" as="geometry"/></mxCell><mxCell id="gap2" value="&lt;b&gt;Quy tắc đang chạy khác tài liệu&lt;/b&gt;&lt;br&gt;Code chỉ bắt giải trình khi &amp;gt; P75; dưới P50 vẫn nhận.&lt;br&gt;Tài liệu 01 hiện viết ‘ngoài P50–P75’ phải giải trình." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2170" y="1595" width="690" height="165" as="geometry"/></mxCell><mxCell id="e-overview-1" value="mở quyền gửi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563EB;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p0" target="k0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k0" target="k1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k2" target="k3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k3" target="k4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k4" target="k5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-7" value="proposal chính thức" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k4" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-8" value="Word + cờ chốt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k5" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-10" value="phạm vi chưa đồng nhất" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p2" target="scopeGap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p4" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-14" value="rớt 1 phần" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="d1" target="k6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-15" value="rớt cả nhóm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="d1" target="k7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-16" value="trúng / đã xử lý" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="d1" target="p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-17" value="tải lại → tổng đổi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0F766E;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k6" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-18" value="xử lý xong" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k6" target="p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k7" target="k8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-20" value="submit vòng bổ sung" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k8" target="k4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1390" y="1130"/><mxPoint x="1435" y="1130"/><mxPoint x="1435" y="750"/><mxPoint x="1390" y="750"/></Array></mxGeometry></mxCell><mxCell id="e-overview-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-22" value="kết quả + quyền 30%" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p5" target="k9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k9" target="k10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-25" value="dữ liệu sử dụng / phản hồi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k10" target="p7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-27" value="mở vòng bổ sung" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p8" target="p0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2920" y="1450"/><mxPoint x="2945" y="1450"/><mxPoint x="2945" y="335"/><mxPoint x="2020" y="335"/></Array></mxGeometry></mxCell><mxCell id="e-overview-28" value="gửi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k11" target="p9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-29" value="duyệt / trả lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p9" target="k11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1570" y="1690"/><mxPoint x="1435" y="1690"/><mxPoint x="1435" y="1775"/><mxPoint x="400" y="1775"/><mxPoint x="400" y="1755"/></Array></mxGeometry></mxCell><mxCell id="e-overview-30" value="chưa chia ngược" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p3" target="gap1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="khoa" name="02 Workflow Khoa chi tiết"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="2080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane-khoa-detail" value="KHOA / ĐVSD" style="swimlane;horizontal=1;startSize=54;rounded=1;arcSize=12;html=1;fillColor=#F0FDFA;swimlaneFillColor=#F0FDFA;strokeColor=#99F6E4;fontColor=#115E59;fontSize=18;fontStyle=1;strokeWidth=2;collapsible=0;pointerEvents=0;locked=1;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="2080" height="1690" as="geometry"/></mxCell><mxCell id="ks0" value="&lt;b&gt;Tín hiệu bắt đầu từ PĐD&lt;/b&gt;&lt;br&gt;Đợt đề xuất đang MỞ" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="270" width="420" height="105" as="geometry"/></mxCell><mxCell id="ks1" value="&lt;b&gt;1. Chọn phạm vi&lt;/b&gt;&lt;br&gt;Loại mua sắm → đợt → gói con&lt;br&gt;Khóa logic: dot_id × goi_id; 18T có 5 gói con" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="455" width="380" height="125" as="geometry"/></mxCell><mxCell id="ks2" value="&lt;b&gt;2. Chọn mã quản lý&lt;/b&gt;&lt;br&gt;Chọn ĐVT chuẩn&lt;br&gt;Nhập đủ hệ số cho các ĐVT còn lại" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="455" width="380" height="125" as="geometry"/></mxCell><mxCell id="ks3" value="&lt;b&gt;3. Tham chiếu nhu cầu&lt;/b&gt;&lt;br&gt;Lịch sử 24 tháng + TSB&lt;br&gt;P50 / P75 / P90 / P95; mặc định P75" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="455" width="380" height="125" as="geometry"/></mxCell><mxCell id="kd1" value="&lt;b&gt;Số &amp;gt; P75?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7C2D12;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1510" y="455" width="190" height="125" as="geometry"/></mxCell><mxCell id="ks4" value="&lt;b&gt;Có&lt;/b&gt;&lt;br&gt;Chọn lý do + ghi chú cụ thể" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1770" y="455" width="310" height="125" as="geometry"/></mxCell><mxCell id="ks5" value="&lt;b&gt;4. Chốt tổng mã quản lý&lt;/b&gt;&lt;br&gt;Có thể chọn phân vị hoặc tự nhập&lt;br&gt;Lưu snapshot quy đổi của lần đề xuất" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="690" width="380" height="125" as="geometry"/></mxCell><mxCell id="ks6" value="&lt;b&gt;5. Phân bổ xuống mã hàng&lt;/b&gt;&lt;br&gt;Chỉ số nguyên dương&lt;br&gt;Quy đổi từng mã về ĐVT chuẩn" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="690" width="380" height="125" as="geometry"/></mxCell><mxCell id="kd2" value="&lt;b&gt;Tổng quy đổi&lt;br&gt;= số đã chốt?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7C2D12;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="690" width="220" height="125" as="geometry"/></mxCell><mxCell id="ks7" value="&lt;b&gt;6. Thêm cả mã quản lý vào giỏ&lt;/b&gt;&lt;br&gt;Giỏ lưu server&lt;br&gt;Account khác cùng Khoa mở lại vẫn thấy" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="925" width="380" height="125" as="geometry"/></mxCell><mxCell id="kd3" value="&lt;b&gt;Đợt còn MỞ?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7C2D12;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="925" width="220" height="125" as="geometry"/></mxCell><mxCell id="ks8" value="&lt;b&gt;7. Gửi giỏ = chính thức&lt;/b&gt;&lt;br&gt;Một transaction; 1 giỏ = 1 gói con&lt;br&gt;Gửi xong xóa bản nháp để tránh gửi trùng" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="925" width="380" height="125" as="geometry"/></mxCell><mxCell id="ks9" value="&lt;b&gt;8. Hoàn thiện hồ sơ Khoa&lt;/b&gt;&lt;br&gt;Tạo Word cam kết ngay&lt;br&gt;Danh mục đề xuất: sửa ô, audit, ẩn/ghim/khóa cột" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1510" y="925" width="380" height="125" as="geometry"/></mxCell><mxCell id="ks10" value="&lt;b&gt;9. Chốt danh mục&lt;/b&gt;&lt;br&gt;Chốt = khóa sửa ở server&lt;br&gt;Khoa hoặc PĐD có thể mở lại; mọi lần đều audit" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1510" y="1160" width="380" height="125" as="geometry"/></mxCell><mxCell id="ks11" value="&lt;b&gt;10. Nhận kết quả thầu&lt;/b&gt;&lt;br&gt;Thông báo rớt + xác nhận đã xem&lt;br&gt;Không tích rớt được; chỉ PĐD có quyền" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="1160" width="380" height="125" as="geometry"/></mxCell><mxCell id="kd4" value="&lt;b&gt;Kết quả?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7C2D12;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="1160" width="220" height="125" as="geometry"/></mxCell><mxCell id="ks12" value="&lt;b&gt;Rớt 1 phần&lt;/b&gt;&lt;br&gt;Đẩy SL sang mã tương đương còn trúng&lt;br&gt;RPC chặn khác mã quản lý; tổng không đổi" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1395" width="380" height="135" as="geometry"/></mxCell><mxCell id="ks13" value="&lt;b&gt;Rớt hoàn toàn&lt;/b&gt;&lt;br&gt;Chọn đợt bổ sung đang mở&lt;br&gt;Chuyển mã vào giỏ bổ sung" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="1395" width="380" height="135" as="geometry"/></mxCell><mxCell id="ks14" value="&lt;b&gt;Trúng / hoàn tất&lt;/b&gt;&lt;br&gt;Mã không bị tích mặc định trúng&lt;br&gt;Theo dõi hợp đồng và hàng về" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="1395" width="380" height="135" as="geometry"/></mxCell><mxCell id="ks15" value="&lt;b&gt;Vòng bổ sung&lt;/b&gt;&lt;br&gt;Điều chỉnh số trong giỏ&lt;br&gt;Gửi lại như một vòng đề xuất mới" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="1635" width="380" height="130" as="geometry"/></mxCell><mxCell id="ks16" value="&lt;b&gt;11. Sau khi hàng về&lt;/b&gt;&lt;br&gt;Theo dõi mức dùng trên số trúng&lt;br&gt;Báo thiếu hàng / sự kiện nhu cầu" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="1635" width="380" height="130" as="geometry"/></mxCell><mxCell id="ks17" value="&lt;b&gt;Luồng hỗ trợ&lt;/b&gt;&lt;br&gt;Đề nghị mã kỹ thuật mới / tương đương&lt;br&gt;Đề nghị sửa tiêu chí → chờ PĐD duyệt" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1510" y="1395" width="380" height="135" as="geometry"/></mxCell><mxCell id="kgap" value="&lt;b&gt;Lưu ý đúng theo code&lt;/b&gt;&lt;br&gt;Dưới P50 vẫn được nhận không cần giải trình.&lt;br&gt;Chỉ &amp;gt; P75 mới bị chặn để bắt lý do + ghi chú." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1650" width="380" height="150" as="geometry"/></mxCell><mxCell id="e-khoa-1" value="đợt mở" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563EB;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks0" target="ks1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks1" target="ks2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks2" target="ks3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks3" target="kd1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-5" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kd1" target="ks4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-6" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kd1" target="ks5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks4" target="ks5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks5" target="ks6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks6" target="kd2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-10" value="đúng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kd2" target="ks7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-11" value="sai → nhập lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kd2" target="ks6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="755"/><mxPoint x="520" y="755"/></Array></mxGeometry></mxCell><mxCell id="e-khoa-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks7" target="kd3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-13" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kd3" target="ks8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-14" value="đóng → giữ giỏ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kd3" target="ks7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="990"/><mxPoint x="520" y="990"/></Array></mxGeometry></mxCell><mxCell id="e-khoa-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks8" target="ks9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks9" target="ks10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks10" target="ks11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks11" target="kd4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-19" value="rớt 1 phần" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kd4" target="ks12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-20" value="rớt hoàn toàn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kd4" target="ks13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-21" value="trúng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kd4" target="ks14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks13" target="ks15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-23" value="giỏ bổ sung" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks15" target="ks7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="1810"/><mxPoint x="70" y="1810"/><mxPoint x="70" y="990"/><mxPoint x="100" y="990"/></Array></mxGeometry></mxCell><mxCell id="e-khoa-24" value="đã chuyển hết SL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks12" target="ks14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="1565"/><mxPoint x="970" y="1565"/><mxPoint x="970" y="1462"/></Array></mxGeometry></mxCell><mxCell id="e-khoa-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks14" target="ks16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pdd" name="03 Workflow PĐD chi tiết"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane-pdd-detail" value="PHÒNG ĐIỀU DƯỠNG" style="swimlane;horizontal=1;startSize=54;rounded=1;arcSize=12;html=1;fillColor=#F8FAFF;swimlaneFillColor=#F8FAFF;strokeColor=#BFDBFE;fontColor=#1E40AF;fontSize=18;fontStyle=1;strokeWidth=2;collapsible=0;pointerEvents=0;locked=1;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="2080" height="1570" as="geometry"/></mxCell><mxCell id="ps1" value="&lt;b&gt;1. Tạo / mở đợt&lt;/b&gt;&lt;br&gt;Chọn loại mua sắm, năm, mốc T1/T5/T9 nếu bổ sung&lt;br&gt;Đóng đợt sẽ chặn Khoa gửi ở DB" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="285" width="380" height="125" as="geometry"/></mxCell><mxCell id="ps2" value="&lt;b&gt;2. Bàn điều hành&lt;/b&gt;&lt;br&gt;Chọn đợt + gói con&lt;br&gt;Theo dõi đề xuất / Word / chốt của 62 Khoa" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="285" width="380" height="125" as="geometry"/></mxCell><mxCell id="ps3" value="&lt;b&gt;3. Theo dõi &amp;amp; nhắc&lt;/b&gt;&lt;br&gt;Lọc Khoa chưa gửi / thiếu Word / chưa chốt&lt;br&gt;Copy mẫu nhắc Zalo / Email / Teams" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="285" width="380" height="125" as="geometry"/></mxCell><mxCell id="ps4" value="&lt;b&gt;4. Danh mục tổng hợp&lt;/b&gt;&lt;br&gt;Cộng theo mã hàng trong đúng đợt + gói con&lt;br&gt;Mở chi tiết đóng góp từng Khoa" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1510" y="285" width="380" height="125" as="geometry"/></mxCell><mxCell id="ps5" value="&lt;b&gt;5. Hiệu chỉnh có audit&lt;/b&gt;&lt;br&gt;Sửa đè, khóa dòng/cột, ẩn cột&lt;br&gt;Khoa thấy phần PĐD sửa nhưng không được ghi" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1510" y="515" width="380" height="135" as="geometry"/></mxCell><mxCell id="ps6" value="&lt;b&gt;6. Hồ sơ trình ký&lt;/b&gt;&lt;br&gt;Xuất Excel danh mục đi thầu&lt;br&gt;Tạo Word Phiếu đề nghị mua thầu" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="515" width="380" height="135" as="geometry"/></mxCell><mxCell id="ps7" value="&lt;b&gt;7. Ba giai đoạn thầu&lt;/b&gt;&lt;br&gt;Chào giá → Mở thầu → Đánh giá&lt;br&gt;Chỉ chọn mã rớt + giai đoạn + lý do" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="515" width="380" height="135" as="geometry"/></mxCell><mxCell id="pd1" value="&lt;b&gt;Có mã rớt?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7C2D12;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="515" width="220" height="135" as="geometry"/></mxCell><mxCell id="ps8" value="&lt;b&gt;8a. Rớt 1 phần / cả nhóm&lt;/b&gt;&lt;br&gt;Tự sync kết quả về mọi Khoa liên quan&lt;br&gt;Có đường bỏ tích nếu chưa xử lý" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="760" width="380" height="145" as="geometry"/></mxCell><mxCell id="ps9" value="&lt;b&gt;8b. Giỏ rớt toàn viện&lt;/b&gt;&lt;br&gt;Theo dõi Khoa còn mã chưa xử lý + số ngày&lt;br&gt;Nhắc Khoa chuyển SL hoặc sang đợt bổ sung" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="760" width="380" height="145" as="geometry"/></mxCell><mxCell id="ps10" value="&lt;b&gt;9. Chờ Khoa xử lý&lt;/b&gt;&lt;br&gt;Rớt 1 phần: tổng đổi khi tải lại&lt;br&gt;Rớt hoàn toàn: Khoa đưa vào giỏ bổ sung" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="760" width="380" height="145" as="geometry"/></mxCell><mxCell id="ps11" value="&lt;b&gt;10. Một cờ chốt / hai thời điểm&lt;/b&gt;&lt;br&gt;UI: chốt số đi thầu; docs: chốt sau thầu&lt;br&gt;Hiện chỉ khóa dot_id, rộng hơn một gói con" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1510" y="760" width="380" height="145" as="geometry"/></mxCell><mxCell id="ps12" value="&lt;b&gt;11. Hoàn thiện kết quả&lt;/b&gt;&lt;br&gt;Mã không bị tích → mặc định trúng&lt;br&gt;Tự tạo gói theo dõi + đủ 5 mốc" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1510" y="1015" width="380" height="145" as="geometry"/></mxCell><mxCell id="ps13" value="&lt;b&gt;12. Hợp đồng&lt;/b&gt;&lt;br&gt;Hoàn thành mốc ký hợp đồng&lt;br&gt;Theo dõi số trúng thầu" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="1015" width="380" height="145" as="geometry"/></mxCell><mxCell id="ps14" value="&lt;b&gt;13. Hàng về đợt đầu&lt;/b&gt;&lt;br&gt;Đánh dấu ngày hàng về&lt;br&gt;Từ đây mới bắt đầu tính cam kết sử dụng" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="1015" width="380" height="145" as="geometry"/></mxCell><mxCell id="ps15" value="&lt;b&gt;14. Giám sát sử dụng&lt;/b&gt;&lt;br&gt;Nạp HIS; chỉnh ngưỡng 6/12/18 tháng&lt;br&gt;Cảnh báo chậm cam kết và sắp hết sớm" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1015" width="380" height="145" as="geometry"/></mxCell><mxCell id="ps16" value="&lt;b&gt;15. Mở vòng bổ sung&lt;/b&gt;&lt;br&gt;Khi có mã rớt hoàn toàn hoặc nguy cơ hết sớm&lt;br&gt;Quay lại tạo / mở đợt bổ sung" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1275" width="380" height="140" as="geometry"/></mxCell><mxCell id="ps17" value="&lt;b&gt;Luồng dùng chung&lt;/b&gt;&lt;br&gt;Xử lý Sổ thiếu hàng&lt;br&gt;Duyệt / trả lại sự kiện nhu cầu" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="1275" width="380" height="140" as="geometry"/></mxCell><mxCell id="ps18" value="&lt;b&gt;Danh mục kỹ thuật&lt;/b&gt;&lt;br&gt;Gán mã hàng / mã quản lý&lt;br&gt;Duyệt hoặc từ chối mã mới và sửa tiêu chí" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="1275" width="380" height="140" as="geometry"/></mxCell><mxCell id="pgap" value="&lt;b&gt;Khoảng trống cần quyết định&lt;/b&gt;&lt;br&gt;Sửa tổng toàn viện chưa tự chia lại proposal từng Khoa.&lt;br&gt;Hiện Khoa chỉ nhìn thấy số sửa đè và lịch sử audit." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1510" y="1260" width="380" height="170" as="geometry"/></mxCell><mxCell id="pgapScope" value="&lt;b&gt;Lỗi mô hình phạm vi: Đợt × Gói con chưa thành một thực thể DB thống nhất&lt;/b&gt;&lt;br&gt;danh_muc_dot_chot chỉ có PK dot_id; patch tạo kết quả mặc định cho mọi proposal trong đợt. PĐD override dùng goi_id:dot:dot_id,&lt;br&gt;nhưng view số chốt và màn Khoa còn dùng goi_id tĩnh. Vì vậy không được hiểu thao tác chốt hiện tại là đã cô lập tuyệt đối từng gói con." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1500" width="1770" height="165" as="geometry"/></mxCell><mxCell id="e-pdd-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps1" target="ps2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps2" target="ps3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps3" target="ps4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps4" target="ps5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps5" target="ps6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps6" target="ps7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps7" target="pd1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-8" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="pd1" target="ps8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-9" value="không / đã xử lý" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="pd1" target="ps11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="590"/><mxPoint x="80" y="690"/><mxPoint x="1700" y="690"/><mxPoint x="1700" y="730"/></Array></mxGeometry></mxCell><mxCell id="e-pdd-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps8" target="ps9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps9" target="ps10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps10" target="ps11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps11" target="ps12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps12" target="ps13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps13" target="ps14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps14" target="ps15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-17" value="sắp hết sớm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps15" target="ps16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-18" value="đợt bổ sung mới" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps16" target="ps1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="1345"/><mxPoint x="70" y="350"/><mxPoint x="100" y="350"/></Array></mxGeometry></mxCell><mxCell id="e-pdd-19" value="chưa có thuật toán" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps5" target="pgap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-20" value="scope chốt quá rộng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps11" target="pgapScope"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="knowledge" name="04 Knowledge graph &amp; checkpoint"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="2100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane-kg-khoa" value="KHOA / ĐVSD" style="swimlane;horizontal=1;startSize=54;rounded=1;arcSize=12;html=1;fillColor=#F0FDFA;swimlaneFillColor=#F0FDFA;strokeColor=#99F6E4;fontColor=#115E59;fontSize=18;fontStyle=1;strokeWidth=2;collapsible=0;pointerEvents=0;locked=1;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="690" height="1680" as="geometry"/></mxCell><mxCell id="lane-kg-system" value="MÔ HÌNH LÕI / HỆ THỐNG" style="swimlane;horizontal=1;startSize=54;rounded=1;arcSize=12;html=1;fillColor=#FAF5FF;swimlaneFillColor=#FAF5FF;strokeColor=#DDD6FE;fontColor=#5B21B6;fontSize=18;fontStyle=1;strokeWidth=2;collapsible=0;pointerEvents=0;locked=1;" vertex="1" parent="1"><mxGeometry x="790" y="210" width="920" height="1680" as="geometry"/></mxCell><mxCell id="lane-kg-pdd" value="PHÒNG ĐIỀU DƯỠNG" style="swimlane;horizontal=1;startSize=54;rounded=1;arcSize=12;html=1;fillColor=#F8FAFF;swimlaneFillColor=#F8FAFF;strokeColor=#BFDBFE;fontColor=#1E40AF;fontSize=18;fontStyle=1;strokeWidth=2;collapsible=0;pointerEvents=0;locked=1;" vertex="1" parent="1"><mxGeometry x="1750" y="210" width="750" height="1680" as="geometry"/></mxCell><mxCell id="kgDot" value="&lt;b&gt;DOT_DE_XUAT&lt;/b&gt;&lt;br&gt;Cổng nhận đề xuất: mo ↔ dong&lt;br&gt;Không đồng nghĩa với chốt Khoa / chốt thầu" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="285" width="540" height="110" as="geometry"/></mxCell><mxCell id="kgScope" value="&lt;b&gt;DOT_GOI = dot_id × goi_id  [THỰC THỂ ĐANG THIẾU]&lt;/b&gt;&lt;br&gt;Một đợt 18T có 5 gói con đi thầu riêng&lt;br&gt;DB hiện chia khóa giữa dot_id, goi_id tĩnh và goi_id:dot:dot_id" style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="900" y="465" width="700" height="165" as="geometry"/></mxCell><mxCell id="kgDraft" value="&lt;b&gt;NHÓM ĐỀ XUẤT / PROPOSAL&lt;/b&gt;&lt;br&gt;Giỏ server → submit transaction&lt;br&gt;Proposal chính thức; không PĐD duyệt giỏ" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="135" y="315" width="540" height="125" as="geometry"/></mxCell><mxCell id="kgCatalog" value="&lt;b&gt;DANH MỤC KHOA&lt;/b&gt;&lt;br&gt;Ô cộng tác + audit + khóa cột&lt;br&gt;Word cam kết được tạo song song" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="135" y="520" width="540" height="125" as="geometry"/></mxCell><mxCell id="kgReady" value="&lt;b&gt;CHECKPOINT 1 — KHOA_READY&lt;/b&gt;&lt;br&gt;Khoa chốt danh mục&lt;br&gt;Có thể mở lại; là trục riêng với trạng thái đợt" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="135" y="725" width="540" height="125" as="geometry"/></mxCell><mxCell id="kgPartial" value="&lt;b&gt;RESULT.failed — Rớt một phần&lt;/b&gt;&lt;br&gt;Đẩy SL sang SKU tương đương cùng mã quản lý&lt;br&gt;Tạo version mới; giữ tổng mã quản lý" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="135" y="1070" width="540" height="140" as="geometry"/></mxCell><mxCell id="kgFull" value="&lt;b&gt;RESULT.failed — Rớt cả nhóm&lt;/b&gt;&lt;br&gt;Chọn đợt bổ sung đang mở&lt;br&gt;Đưa vào giỏ nháp → phải submit bổ sung riêng" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="135" y="1285" width="540" height="140" as="geometry"/></mxCell><mxCell id="kgSupport" value="&lt;b&gt;PHẢN HỒI VẬN HÀNH&lt;/b&gt;&lt;br&gt;Thiếu hàng · sự kiện nhu cầu · mã kỹ thuật&lt;br&gt;Làm dữ liệu đầu vào cho kỳ kế tiếp" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="135" y="1530" width="540" height="140" as="geometry"/></mxCell><mxCell id="kgTracker" value="&lt;b&gt;TENDER_TRACKER&lt;/b&gt;&lt;br&gt;5 mốc: chào giá → mở thầu → đánh giá&lt;br&gt;→ ký hợp đồng → hàng về đợt đầu" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="760" width="540" height="130" as="geometry"/></mxCell><mxCell id="kgResult" value="&lt;b&gt;RESULT = SKU × Khoa&lt;/b&gt;&lt;br&gt;Mặc định trúng; PĐD chỉ ghi dòng rớt&lt;br&gt;khoa_da_xem và da_xu_ly là hai trục riêng" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="990" width="540" height="140" as="geometry"/></mxCell><mxCell id="kgFinal" value="&lt;b&gt;CHECKPOINT 3 — TENDER_RESULT_FINALIZED  [ĐANG THIẾU]&lt;/b&gt;&lt;br&gt;Cần chốt sau 3 giai đoạn và sau khi Khoa xử lý rớt&lt;br&gt;Hiện chưa có entity/cờ độc lập để phân biệt với số đầu vào đi thầu" style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="900" y="1235" width="700" height="155" as="geometry"/></mxCell><mxCell id="kgUsage" value="&lt;b&gt;USAGE_MONITOR&lt;/b&gt;&lt;br&gt;Số trúng + hàng về + HIS&lt;br&gt;Cam kết sử dụng / chậm / dự kiến hết sớm" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="1510" width="540" height="140" as="geometry"/></mxCell><mxCell id="kgAxes" value="&lt;b&gt;Các trục trạng thái độc lập&lt;/b&gt;&lt;br&gt;Đợt · Khoa-ready · đầu vào thầu · kết quả · mốc thầu&lt;br&gt;proposal current/rút/đã đi thầu · đã xem · đã xử lý" style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="850" y="1710" width="800" height="130" as="geometry"/></mxCell><mxCell id="kgAggregate" value="&lt;b&gt;PDD_AGGREGATE&lt;/b&gt;&lt;br&gt;Tổng hợp đúng phạm vi Đợt × Gói con&lt;br&gt;Drill-down đóng góp từng Khoa" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1825" y="390" width="600" height="130" as="geometry"/></mxCell><mxCell id="kgOverride" value="&lt;b&gt;OVERRIDE / LOCK / AUDIT&lt;/b&gt;&lt;br&gt;PĐD sửa tổng, khóa dòng/cột, xuất hồ sơ&lt;br&gt;Chưa chia ngược tổng vào proposal từng Khoa" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1825" y="600" width="600" height="135" as="geometry"/></mxCell><mxCell id="kgFreeze" value="&lt;b&gt;CHECKPOINT 2 — TENDER_INPUT_FROZEN&lt;/b&gt;&lt;br&gt;Cần đóng băng số trước khi mang đi thầu&lt;br&gt;Hiện dùng chung cờ chốt với thời điểm sau thầu" style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1825" y="815" width="600" height="145" as="geometry"/></mxCell><mxCell id="kgTender" value="&lt;b&gt;BA GIAI ĐOẠN ĐẤU THẦU&lt;/b&gt;&lt;br&gt;Chào giá → Mở thầu → Đánh giá&lt;br&gt;Tích mã rớt + lý do; mã không tích mặc định trúng" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1825" y="1040" width="600" height="140" as="geometry"/></mxCell><mxCell id="kgContract" value="&lt;b&gt;HỢP ĐỒNG / HÀNG VỀ&lt;/b&gt;&lt;br&gt;Hoàn thành mốc ký hợp đồng&lt;br&gt;Đánh dấu hàng về đợt đầu" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1825" y="1360" width="600" height="140" as="geometry"/></mxCell><mxCell id="kgCritical" value="&lt;b&gt;P0 — SPLIT-BRAIN HIỆN TẠI&lt;/b&gt;&lt;br&gt;Chốt mới chỉ dot_id; khóa/view cũ còn gói+năm&lt;br&gt;Override PĐD dùng goi:dot:id; Khoa/view dùng goi tĩnh&lt;br&gt;Proposal current-version chưa có dot_id" style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1825" y="1585" width="600" height="190" as="geometry"/></mxCell><mxCell id="e-knowledge-1" value="có nhiều gói con" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=