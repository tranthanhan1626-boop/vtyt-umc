ackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks8" target="ks9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks9" target="ks10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks9" target="ks11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-16" value="dữ liệu đổi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks11" target="kcancel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-17" value="bấm lại → lần N+1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kcancel" target="ks11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="1130"/><mxPoint x="1235" y="1130"/></Array></mxGeometry></mxCell><mxCell id="e-khoa-18" value="không có nhu cầu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks1" target="ksNo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="527"/><mxPoint x="545" y="527"/><mxPoint x="545" y="1100"/><mxPoint x="1810" y="1100"/><mxPoint x="1810" y="1145"/></Array></mxGeometry></mxCell><mxCell id="e-khoa-19" value="PĐD chốt Q rồi đấu thầu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563EB;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks11" target="kd4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-20" value="còn số trúng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kd4" target="ks14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-21" value="trúng 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kd4" target="ks13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1620" y="1525"/><mxPoint x="1620" y="1560"/><mxPoint x="775" y="1560"/><mxPoint x="775" y="1525"/></Array></mxGeometry></mxCell><mxCell id="e-khoa-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks13" target="ks15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-23" value="đề xuất lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks15" target="kbosung"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-24" value="bổ sung" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kbosung" target="ks7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="775" y="1790"/><mxPoint x="110" y="1790"/><mxPoint x="110" y="993"/><mxPoint x="100" y="993"/></Array></mxGeometry></mxCell><mxCell id="e-khoa-25" value="sau chốt trình ký" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks14" target="ks16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pdd" name="03 Workflow PĐD chi tiết"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2260" pageHeight="2010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane-pdd-detail" value="PHÒNG ĐIỀU DƯỠNG (cũng là admin — cùng quyền)" style="swimlane;horizontal=1;startSize=54;rounded=1;arcSize=12;html=1;fillColor=#F8FAFF;swimlaneFillColor=#F8FAFF;strokeColor=#BFDBFE;fontColor=#1E40AF;fontSize=18;fontStyle=1;strokeWidth=2;collapsible=0;pointerEvents=0;locked=1;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="2140" height="1640" as="geometry"/></mxCell><mxCell id="ps1" value="&lt;b&gt;1 · Tạo / mở đợt&lt;/b&gt;&lt;br&gt;Hệ tự sinh 5 DOT_GOI cho gói 18T&lt;br&gt;Mỗi đợt bổ sung = 1 gói phẳng&lt;br&gt;Đóng đợt là chặn ở DB, không chỉ ở giao diện" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="280" width="390" height="135" as="geometry"/></mxCell><mxCell id="ps2" value="&lt;b&gt;2 · Phân gói con &amp;amp; khoa&lt;/b&gt;&lt;br&gt;Phân mã quản lý vào từng gói con&lt;br&gt;Chỉ định danh sách khoa tham gia&lt;br&gt;Đổi được tới khi chốt Q" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="580" y="280" width="390" height="135" as="geometry"/></mxCell><mxCell id="ps3" value="&lt;b&gt;3 · Bàn điều hành&lt;/b&gt;&lt;br&gt;Theo dõi: đã gửi · đã xác nhận · Word&lt;br&gt;Lọc khoa còn thiếu → nhắc qua Teams&lt;br&gt;Web KHÔNG tự gửi thông báo" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="280" width="390" height="135" as="geometry"/></mxCell><mxCell id="ps4" value="&lt;b&gt;4 · Danh mục tổng hợp&lt;/b&gt;&lt;br&gt;Cộng theo mã hàng trong đúng một DOT_GOI&lt;br&gt;Cột SỐ là VIEW SUM — KHÔNG sửa trực tiếp được&lt;br&gt;Cột CHỮ sửa đè trực tiếp (đè cho toàn viện)" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="280" width="620" height="135" as="geometry"/></mxCell><mxCell id="ps5" value="&lt;b&gt;5 · Hiệu chỉnh số&lt;/b&gt;&lt;br&gt;PĐD gõ TỔNG của mã → hệ chia sẵn theo tỉ lệ khoa đã đề xuất&lt;br&gt;(làm tròn xuống, phần dư dồn vào khoa có số lớn nhất) — PĐD sửa tay được&lt;br&gt;Không lưu được nếu tổng các dòng chưa khớp tổng mới" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="510" width="620" height="145" as="geometry"/></mxCell><mxCell id="ps5b" value="&lt;b&gt;Sửa số sau khi khoa đã xác nhận&lt;/b&gt;&lt;br&gt;BẮT BUỘC nhập lý do.&lt;br&gt;Khoa thấy số cũ, số mới, người sửa và lý do&lt;br&gt;ngay trên bảng của mình." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="510" width="390" height="145" as="geometry"/></mxCell><mxCell id="psq" value="&lt;b&gt;6 · CHỐT SỐ THAM GIA ĐẤU THẦU  →  Q&lt;/b&gt;&lt;br&gt;CỔNG CỨNG — chỉ bấm được khi MỌI khoa ĐÃ GỬI đề xuất đều đã xác nhận bản hiện tại.&lt;br&gt;Khoa tham gia mà chưa gửi gì thì KHÔNG tính (nếu tính, nút không bao giờ sáng).&lt;br&gt;Tạo snapshot Q bất biến · Khoá phạm vi: không thêm mã, không đổi gói con nữa." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="510" width="850" height="145" as="geometry"/></mxCell><mxCell id="ps7" value="&lt;b&gt;7 · Ba giai đoạn đấu thầu&lt;/b&gt;&lt;br&gt;Chào giá → Mở thầu → Đánh giá&lt;br&gt;Phải hoàn thành giai đoạn trước mới sang sau&lt;br&gt;Mở lại: bắt lý do; giai đoạn SAU hết hiệu lực" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="745" width="390" height="145" as="geometry"/></mxCell><mxCell id="pd1" value="&lt;b&gt;Mã này&lt;br&gt;có rớt?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7C2D12;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="580" y="745" width="240" height="145" as="geometry"/></mxCell><mxCell id="psWin" value="&lt;b&gt;MẶC ĐỊNH TRÚNG TOÀN BỘ&lt;/b&gt;&lt;br&gt;Không nhập ngoại lệ → số trúng = Q, số rớt = 0.&lt;br&gt;PĐD KHÔNG phải tích trúng cho hàng nghìn mã." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="890" y="745" width="540" height="145" as="geometry"/></mxCell><mxCell id="ps8" value="&lt;b&gt;8 · Nhập ngoại lệ rớt — cấp MÃ HÀNG&lt;/b&gt;&lt;br&gt;Nhập: mã hàng · giai đoạn · toàn bộ hay một phần · số lượng · lý do&lt;br&gt;Nút “Rớt toàn bộ mã quản lý” tự rải xuống mọi mã hàng bên trong&lt;br&gt;Rớt được ở NHIỀU giai đoạn: ΣR = R1+R2+R3 · KHOÁ CỨNG 3: 0 ≤ ΣR ≤ Q" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="745" width="620" height="145" as="geometry"/></mxCell><mxCell id="ps9" value="&lt;b&gt;9 · Phân bổ số trúng về khoa&lt;/b&gt;&lt;br&gt;Số trúng = Q − ΣR  ·  CHỈ PĐD được phân bổ&lt;br&gt;Trúng toàn bộ → giữ nguyên phân bổ Q, không phải nhập lại&lt;br&gt;Trúng một phần → chia sẵn theo tỉ lệ Q · Rớt toàn bộ → mọi khoa = 0" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="975" width="620" height="150" as="geometry"/></mxCell><mxCell id="ps9b" value="&lt;b&gt;KHOÁ CỨNG 2&lt;/b&gt;&lt;br&gt;Tổng phân bổ = số trúng của mã.&lt;br&gt;Không có kho dự phòng, không có số chưa phân bổ.&lt;br&gt;Vượt Q của một khoa: được, nhưng phải có lý do." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="975" width="390" height="150" as="geometry"/></mxCell><mxCell id="ps10" value="&lt;b&gt;10 · Theo dõi cuốn chiếu&lt;/b&gt;&lt;br&gt;Đọc theo TỪNG MÃ HÀNG RỚT, sổ ra danh sách khoa&lt;br&gt;Ô trống ở cột Đợt bổ sung = CUỐN CHIẾU HỎNG&lt;br&gt;— không phải đang chờ khoa. Có nút “Chạy lại”" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="580" y="975" width="390" height="150" as="geometry"/></mxCell><mxCell id="ps11" value="&lt;b&gt;11 · Mở đợt bổ sung&lt;/b&gt;&lt;br&gt;3 đợt/năm: T1 · T5 · T9&lt;br&gt;Pipeline bổ sung ĐỘC LẬP,&lt;br&gt;không chặn việc chốt kết quả của gói gốc" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="975" width="390" height="150" as="geometry"/></mxCell><mxCell id="ps12" value="&lt;b&gt;12 · CHỐT DỮ LIỆU TRÌNH KÝ&lt;/b&gt;&lt;br&gt;Chốt từng bảng khoa → rồi “Chốt toàn bộ” mới tạo được revision chính thức.&lt;br&gt;QĐ 20/08/2026 — cổng chỉ tính khoa ĐÃ GỬI đề xuất; khoa im lặng ghi vào audit, KHÔNG chặn.&lt;br&gt;Khi chốt: khoá toàn bộ DOT_GOI · Excel khoa và Excel tổng hợp dùng CÙNG revision." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1210" width="850" height="150" as="geometry"/></mxCell><mxCell id="ps13" value="&lt;b&gt;13 · Xuất Excel chính thức&lt;/b&gt;&lt;br&gt;Trước khi chốt: chỉ xuất được bản NHÁP&lt;br&gt;Số trên Excel cuối là SỐ TRÚNG đã phân bổ&lt;br&gt;File sinh tạm rồi xoá — web không lưu file nhị phân" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="1210" width="390" height="150" as="geometry"/></mxCell><mxCell id="ps14" value="&lt;b&gt;Mở lại sau khi đã chốt&lt;/b&gt;&lt;br&gt;Mở một bảng khoa → bản tổng hợp TỰ HẾT HIỆU LỰC, revision cũ mất giá trị.&lt;br&gt;Chỉ bảng khoa đó mở, các bảng khác vẫn khoá. Mọi lần mở lại BẮT LÝ DO.&lt;br&gt;Hệ không cưỡng chế được bản giấy đã in — nên mọi file đều in revision + thời điểm." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="1210" width="620" height="150" as="geometry"/></mxCell><mxCell id="ps15" value="&lt;b&gt;14 · Sau trình ký&lt;/b&gt;&lt;br&gt;Bật tuỳ chọn mua thêm 30% cho các khoa&lt;br&gt;Trả mã hàng về danh sách khoa cho kỳ sau" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1445" width="390" height="145" as="geometry"/></mxCell><mxCell id="ps16" value="&lt;b&gt;15 · Tiến độ sử dụng&lt;/b&gt;&lt;br&gt;Nạp HIS · chỉnh ngưỡng cam kết 20/50/80&lt;br&gt;Tách CHẬM CAM KẾT và SẮP HẾT SỚM&lt;br&gt;Module sau khi hàng về, ngoài pipeline" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="580" y="1445" width="390" height="145" as="geometry"/></mxCell><mxCell id="ps17" value="&lt;b&gt;Luồng dùng chung&lt;/b&gt;&lt;br&gt;Xử lý Sổ thiếu hàng&lt;br&gt;Duyệt mã kỹ thuật mới khoa đề nghị&lt;br&gt;Duyệt đề nghị sửa tiêu chí kỹ thuật" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="1445" width="390" height="145" as="geometry"/></mxCell><mxCell id="pgap" value="&lt;b&gt;⚠ NỢ KỸ THUẬT ĐANG CÒN (20/08/2026)&lt;/b&gt;&lt;br&gt;danh_muc_khoa_o chưa có cột neo đợt → 3 đợt bổ sung/năm dùng chung goi_id &apos;bo-sung&apos;&lt;br&gt;và cùng năm, nên xài chung một dòng giải trình. Fix lan tới 6 RPC + 3 chỗ đọc frontend.&lt;br&gt;Chi tiết: ../05_TRANG_THAI_VA_VIEC_TIEP_THEO.md mục 3." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="1445" width="620" height="145" as="geometry"/></mxCell><mxCell id="e-pdd-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps1" target="ps2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps2" target="ps3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps3" target="ps4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps4" target="ps5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-5" value="bắt lý do" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps5" target="ps5b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-6" value="số đã ổn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps5" target="psq"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1810" y="655"/><mxPoint x="1810" y="700"/><mxPoint x="545" y="700"/><mxPoint x="545" y="500"/></Array></mxGeometry></mxCell><mxCell id="e-pdd-7" value="Q đã đóng băng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="psq" target="ps7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps7" target="pd1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-9" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="pd1" target="psWin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-10" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="pd1" target="ps8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="890"/><mxPoint x="700" y="925"/><mxPoint x="1810" y="925"/><mxPoint x="1810" y="890"/></Array></mxGeometry></mxCell><mxCell id="e-pdd-11" value="giữ nguyên phân bổ Q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="psWin" target="ps9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="890"/><mxPoint x="1160" y="940"/><mxPoint x="1810" y="940"/><mxPoint x="1810" y="965"/></Array></mxGeometry></mxCell><mxCell id="e-pdd-12" value="số trúng = Q − ΣR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps8" target="ps9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps9" target="ps9b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-14" value="mã quản lý trúng 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps9" target="ps10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1810" y="1125"/><mxPoint x="1810" y="1160"/><mxPoint x="775" y="1160"/><mxPoint x="775" y="1125"/></Array></mxGeometry></mxCell><mxCell id="e-pdd-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps10" target="ps11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-16" value="đợt bổ sung mới" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps11" target="ps1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="1050"/><mxPoint x="80" y="348"/><mxPoint x="100" y="348"/></Array></mxGeometry></mxCell><mxCell id="e-pdd-17" value="đã phân bổ hết" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps9" target="ps12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1810" y="1125"/><mxPoint x="1810" y="1185"/><mxPoint x="545" y="1185"/><mxPoint x="545" y="1200"/></Array></mxGeometry></mxCell><mxCell id="e-pdd-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps12" target="ps13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps13" target="ps14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps12" target="ps15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps15" target="ps16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pdd-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ps16" target="ps17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="knowledge" name="04 Kiến trúc số &amp; checkpoint"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane-kg-khoa" value="KHOA / ĐVSD" style="swimlane;horizontal=1;startSize=54;rounded=1;arcSize=12;html=1;fillColor=#F0FDFA;swimlaneFillColor=#F0FDFA;strokeColor=#99F6E4;fontColor=#115E59;fontSize=18;fontStyle=1;strokeWidth=2;collapsible=0;pointerEvents=0;locked=1;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="700" height="1660" as="geometry"/></mxCell><mxCell id="lane-kg-system" value="MÔ HÌNH LÕI" style="swimlane;horizontal=1;startSize=54;rounded=1;arcSize=12;html=1;fillColor=#FAF5FF;swimlaneFillColor=#FAF5FF;strokeColor=#DDD6FE;fontColor=#5B21B6;fontSize=18;fontStyle=1;strokeWidth=2;collapsible=0;pointerEvents=0;locked=1;" vertex="1" parent="1"><mxGeometry x="800" y="210" width="930" height="1660" as="geometry"/></mxCell><mxCell id="lane-kg-pdd" value="PHÒNG ĐIỀU DƯỠNG" style="swimlane;horizontal=1;startSize=54;rounded=1;arcSize=12;html=1;fillColor=#F8FAFF;swimlaneFillColor=#F8FAFF;strokeColor=#BFDBFE;fontColor=#1E40AF;fontSize=18;fontStyle=1;strokeWidth=2;collapsible=0;pointerEvents=0;locked=1;" vertex="1" parent="1"><mxGeometry x="1770" y="210" width="760" height="1660" as="geometry"/></mxCell><mxCell id="kgDot" value="&lt;b&gt;DOT_DE_XUAT&lt;/b&gt;&lt;br&gt;Cổng nhận đề xuất: mo ↔ dong. Một đợt 18T sinh 5 DOT_GOI; mỗi đợt bổ sung sinh 1." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="870" y="280" width="790" height="115" as="geometry"/></mxCell><mxCell id="kgScope" value="&lt;b&gt;DOT_GOI = Đợt × Gói con   ⟵ đơn vị workflow thật&lt;/b&gt;&lt;br&gt;Mỗi DOT_GOI có riêng: khoa tham gia · trạng thái · danh mục · snapshot Q · ba giai đoạn ·&lt;br&gt;kết quả · phân bổ · revision. Chốt/mở/sửa một gói con KHÔNG tác động bốn gói còn lại." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="870" y="445" width="790" height="130" as="geometry"/></mxCell><mxCell id="kgProp" value="&lt;b&gt;proposals — DẤU VẾT GỐC&lt;/b&gt;&lt;br&gt;Khoa gửi giỏ trong một transaction.&lt;br&gt;BẤT BIẾN — không ai sửa đè, kể cả PĐD." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="130" y="625" width="590" height="130" as="geometry"/></mxCell><mxCell id="kgAlloc" value="&lt;b&gt;phan_bo_khoa — SỐ HIỆN HÀNH  (nguồn DUY NHẤT)&lt;/b&gt;&lt;br&gt;Khoá theo (DOT_GOI × mã hàng × khoa). Khoa và PĐD CÙNG sửa ở đây.&lt;br&gt;so_luong_goc đóng băng làm dấu vết khi khoa tự sửa." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="870" y="625" width="790" height="130" as="geometry"/></mxCell><mxCell id="kgView" value="&lt;b&gt;Danh mục tổng hợp = VIEW SUM&lt;/b&gt;&lt;br&gt;Cộng lên, KHÔNG lưu số riêng.&lt;br&gt;Vì vậy “tổng PĐD = tổng phân bổ về khoa”&lt;br&gt;đúng THEO CẤU TRÚC, không cần code canh." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1840" y="625" width="620" height="130" as="geometry"/></mxCell><mxCell id="kgText" value="&lt;b&gt;CỘT CHỮ — một giá trị chung toàn viện (danh_muc_tong_hop_o)&lt;/b&gt;&lt;br&gt;TSKT là thuộc tính của MÃ HÀNG, không phải của khoa. Ai sửa sau đè, khoa hay PĐD đều vậy.&lt;br&gt;Ngoại lệ duy nhất: giai_trinh_2627 lưu riêng theo khoa ở danh_muc_khoa_o." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="130" y="800" width="1530" height="130" as="geometry"/></mxCell><mxCell id="kgConfirm" value="&lt;b&gt;VÒNG XÁC NHẬN lần N  (danh_muc_khoa_chot)&lt;/b&gt;&lt;br&gt;Không khoá dữ liệu. Có sửa là xác nhận tự huỷ,&lt;br&gt;kể cả khi khoa KHÁC sửa cột chữ chung của mã đó.&lt;br&gt;Bấm lại → lần N+1, không giới hạn." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="130" y="980" width="590" height="135" as="geometry"/></mxCell><mxCell id="kgQ" value="&lt;b&gt;CHECKPOINT 1 — CHỐT Q  (chot_q_phien + chot_q_dong)&lt;/b&gt;&lt;br&gt;Cổng CỨNG: mọi khoa đã gửi phải đã xác nhận. Khoa chưa gửi gì thì không tính.&lt;br&gt;Snapshot BẤT BIẾN theo (DOT_GOI × mã hàng × khoa) → khoá cột SỐ, khoá phạm vi danh mục." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="870" y="980" width="790" height="135" as="geometry"/></mxCell><mxCell id="kgStage" value="&lt;b&gt;giai_doan_thau_v3&lt;/b&gt;&lt;br&gt;Chào giá → Mở thầu → Đánh giá.&lt;br&gt;Đúng thứ tự; mở lại làm giai đoạn SAU&lt;br&gt;hết hiệu lực và bắt nhập lý do." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1840" y="980" width="620" height="135" as="geometry"/></mxCell><mxCell id="kgRot" value="&lt;b&gt;ket_qua_rot_v3 — chỉ ghi NGOẠI LỆ RỚT&lt;/b&gt;&lt;br&gt;Mặc định mọi mã TRÚNG TOÀN BỘ. Rớt ghi ở cấp MÃ HÀNG, được ở nhiều giai đoạn.&lt;br&gt;Số trúng = Q − (R1+R2+R3).   KHOÁ CỨNG 3: 0 ≤ ΣR ≤ Q." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="870" y="1165" width="790" height="140" as="geometry"/></mxCell><mxCell id="kgWin" value="&lt;b&gt;phan_bo_trung_v3&lt;/b&gt;&lt;br&gt;CHỈ PĐD phân bổ. Chỉ khoa đã đề xuất mã&lt;br&gt;mới được nhận. KHOÁ CỨNG 2: tổng phân bổ&lt;br&gt;= số trúng. Không có kho dự phòng." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1840" y="1165" width="620" height="140" as="geometry"/></mxCell><mxCell id="kgBasket" value="&lt;b&gt;chuyen_so_rot_v3 · cuon_chieu_rot_v3&lt;/b&gt;&lt;br&gt;Hai sổ GHI THÊM, không đụng phan_bo_trung_v3.&lt;br&gt;Đổ sang mã tương đương: cùng mã quản lý, giữ số theo khoa,&lt;br&gt;lệch ĐVT thì CHẶN. Phần chưa đổ thì cuốn chiếu HẾT." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="130" y="1165" width="590" height="140" as="geometry"/></mxCell><mxCell id="kgFinal" value="&lt;b&gt;CHECKPOINT 2 — CHỐT TRÌNH KÝ  (chot_trinh_ky_phien_v3)&lt;/b&gt;&lt;br&gt;Chốt từng bảng khoa → chốt toàn bộ → revision chính thức, bất biến.&lt;br&gt;QĐ 20/08: cổng chỉ tính khoa đã gửi đề xuất. Khi chốt: khoá cột CHỮ, khoá cả DOT_GOI." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="870" y="1355" width="790" height="140" as="geometry"/></mxCell><mxCell id="kg30" value="&lt;b&gt;tuy_chon_mua_them_30_v3&lt;/b&gt;&lt;br&gt;CHỈ bật sau CHECKPOINT 2.&lt;br&gt;Trần = floor(số trúng của khoa × 30%),&lt;br&gt;tính ở cấp khoa × mã quản lý." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="130" y="1355" width="590" height="140" as="geometry"/></mxCell><mxCell id="kgRev" value="&lt;b&gt;Revision &amp;amp; Excel chính thức&lt;/b&gt;&lt;br&gt;Excel khoa và Excel tổng hợp cùng revision.&lt;br&gt;Mở lại một bảng khoa → revision tổng hợp&lt;br&gt;tự hết hiệu lực. File sinh tạm rồi xoá." style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1840" y="1355" width="620" height="140" as="geometry"/></mxCell><mxCell id="kgAxes" value="&lt;b&gt;Các trục trạng thái ĐỘC LẬP — đừng gộp&lt;/b&gt;&lt;br&gt;Trạng thái DOT_GOI  ·  vòng xác nhận lần N của từng khoa  ·  snapshot Q  ·  ba giai đoạn thầu&lt;br&gt;·  kết quả rớt/trúng  ·  xử lý giỏ rớt  ·  revision trình ký  ·  hạn mức 30% đã dùng" style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="870" y="1550" width="790" height="130" as="geometry"/></mxCell><mxCell id="kgOut" value="&lt;b&gt;NGOÀI PIPELINE&lt;/b&gt;&lt;br&gt;Sổ thiếu hàng · Điều chỉnh tiêu chí kỹ thuật&lt;br&gt;· Duyệt mã kỹ thuật · Tiến độ sử dụng.&lt;br&gt;Không chặn bước nào. ⚠ Chưa test lần nào." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="130" y="1550" width="590" height="130" as="geometry"/></mxCell><mxCell id="kgDebt" value="&lt;b&gt;⚠ Nợ kỹ thuật còn lại&lt;/b&gt;&lt;br&gt;danh_muc_khoa_o chưa neo đợt → gói bổ sung&lt;br&gt;dùng chung một dòng giải trình cho cả 3 đợt/năm.&lt;br&gt;Xem ../05_TRANG_THAI_VA_VIEC_TIEP_THEO.md." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1840" y="1550" width="620" height="130" as="geometry"/></mxCell><mxCell id="kgNo" value="&lt;b&gt;KHÔNG có trong hệ thống — đừng dựng lại (chi tiết: ../06_DUNG_LAM_LAI.md)&lt;/b&gt;&lt;br&gt;Bước PĐD duyệt giỏ · khoá ô sau khi PĐD sửa · mỗi khoa một bản cột chữ riêng · khoa tự đẩy SL từ mã rớt sang mã tương đương&lt;br&gt;· Sổ sự kiện nhu cầu · vòng đời duyệt hồ sơ Word/Excel · MỌI cột giá · hạn nộp, nhắc tự động, thông báo tự động" style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="130" y="1720" width="2330" height="120" as="geometry"/></mxCell><mxCell id="e-knowledge-1" value="sinh gói con" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgDot" target="kgScope"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-knowledge-2" value="khoa gửi giỏ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0F766E;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgScope" target="kgProp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-knowledge-3" value="khởi tạo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgProp" target="kgAlloc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-knowledge-4" value="SUM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563EB;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgAlloc" target="kgView"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-knowledge-5" value="cột chữ tách riêng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgAlloc" target="kgText"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-knowledge-6" value="đổi ô → huỷ xác nhận" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgText" target="kgConfirm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-knowledge-7" value="cổng cứng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgConfirm" target="kgQ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-knowledge-8" value="đóng băng số" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563EB;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgView" target="kgQ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-knowledge-9" value="mở ba giai đoạn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgQ" target="kgStage"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-knowledge-10" value="ghi ngoại lệ rớt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgStage" target="kgRot"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-knowledge-11" value="số trúng = Q − ΣR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563EB;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgRot" target="kgWin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-knowledge-12" value="mã quản lý trúng 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgRot" target="kgBasket"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-knowledge-13" value="bổ sung" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgBasket" target="kgProp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="1235"/><mxPoint x="105" y="690"/><mxPoint x="110" y="690"/></Array></mxGeometry></mxCell><mxCell id="e-knowledge-14" value="đã phân bổ hết" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgWin" target="kgFinal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2150" y="1305"/><mxPoint x="2150" y="1330"/><mxPoint x="1265" y="1330"/><mxPoint x="1265" y="1345"/></Array></mxGeometry></mxCell><mxCell id="e-knowledge-15" value="tạo revision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563EB;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgFinal" target="kgRev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-knowledge-16" value="mới bật được 30%" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgFinal" target="kg30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-knowledge-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="kgFinal" target="kgAxes"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
