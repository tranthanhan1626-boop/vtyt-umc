<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-08-16T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false"><diagram id="overview" name="01 Tổng quan Khoa ↔ PĐD"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3060" pageHeight="2150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane-khoa" value="KHOA / ĐƠN VỊ SỬ DỤNG (ĐVSD)" style="swimlane;horizontal=1;startSize=54;rounded=1;arcSize=12;html=1;fillColor=#F0FDFA;swimlaneFillColor=#F0FDFA;strokeColor=#99F6E4;fontColor=#115E59;fontSize=18;fontStyle=1;strokeWidth=2;collapsible=0;pointerEvents=0;locked=1;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="1390" height="1780" as="geometry"/></mxCell><mxCell id="lane-pdd" value="PHÒNG ĐIỀU DƯỠNG (PĐD) — cũng là admin" style="swimlane;horizontal=1;startSize=54;rounded=1;arcSize=12;html=1;fillColor=#F8FAFF;swimlaneFillColor=#F8FAFF;strokeColor=#BFDBFE;fontColor=#1E40AF;fontSize=18;fontStyle=1;strokeWidth=2;collapsible=0;pointerEvents=0;locked=1;" vertex="1" parent="1"><mxGeometry x="1530" y="210" width="1470" height="1780" as="geometry"/></mxCell><mxCell id="p0" value="&lt;b&gt;1 · Chuẩn bị đợt&lt;/b&gt;&lt;br&gt;Tạo đợt → hệ sinh 5 DOT_GOI (gói 18T)&lt;br&gt;Phân mã quản lý vào từng gói con&lt;br&gt;Chỉ định khoa tham gia · Mở đợt" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1620" y="275" width="400" height="145" as="geometry"/></mxCell><mxCell id="rule" value="&lt;b&gt;LUẬT V2 — MỘT GIÁ TRỊ CHUNG (19/08/2026)&lt;/b&gt;&lt;br&gt;Cột CHỮ: một giá trị chung toàn viện cho mỗi (mã hàng, cột). AI SỬA SAU ĐÈ — khoa đè được lên PĐD.&lt;br&gt;Ngoại lệ duy nhất: giai_trinh_2627 riêng theo khoa.  ·  Cột SỐ: mỗi khoa một số, tổng = phép cộng." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2070" y="275" width="800" height="145" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;2 · Lập số ở cấp MÃ QUẢN LÝ&lt;/b&gt;&lt;br&gt;Chọn một ĐVT chuẩn + hệ số quy đổi&lt;br&gt;Lịch sử 24 tháng → P50 · P75 · P90 · P95&lt;br&gt;P50 là mức chọn sẵn; số không tự điền" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="470" width="400" height="150" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;3 · Phân bổ xuống mã hàng&lt;/b&gt;&lt;br&gt;Chốt tổng ở cấp mã quản lý trước&lt;br&gt;KHOÁ CỨNG 1 — tổng sau quy đổi phải&lt;br&gt;đúng bằng số đã chốt" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="595" y="470" width="400" height="150" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;4 · Gửi giỏ = CHÍNH THỨC&lt;/b&gt;&lt;br&gt;Một transaction · 1 giỏ = 1 gói con&lt;br&gt;Giỏ sống trên server, cùng khoa dùng chung&lt;br&gt;KHÔNG có bước PĐD duyệt giỏ" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="470" width="380" height="150" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b&gt;5 · Danh mục đề xuất của khoa&lt;/b&gt;&lt;br&gt;Khoa sửa SỐ của khoa mình ngay tại đây&lt;br&gt;Cột CHỮ sửa được — đè cho toàn viện&lt;br&gt;Dải P50–P75; vượt P75 chỉ TÔ NỔI BẬT" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="700" width="400" height="155" as="geometry"/></mxCell><mxCell id="k5" value="&lt;b&gt;6 · Xác nhận thông tin lần N&lt;/b&gt;&lt;br&gt;Thay cho “khoa chốt danh mục” đã bỏ&lt;br&gt;Không khoá gì cả&lt;br&gt;Dữ liệu đổi → xác nhận TỰ HUỶ, lên lần N+1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="595" y="700" width="400" height="155" as="geometry"/></mxCell><mxCell id="kword" value="&lt;b&gt;Word cam kết&lt;/b&gt;&lt;br&gt;Bấm là ra, bất kỳ lúc nào&lt;br&gt;Không phải checkpoint&lt;br&gt;In revision + thời điểm sinh lên file" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="700" width="380" height="155" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;7 · Bàn điều hành&lt;/b&gt;&lt;br&gt;Theo dõi khoa nào đã gửi / đã xác nhận&lt;br&gt;Mở thẳng danh mục của từng khoa&lt;br&gt;Nhắc qua Teams — web không tự nhắc" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1620" y="470" width="400" height="150" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;8 · Danh mục tổng hợp&lt;/b&gt;&lt;br&gt;Cột SỐ là VIEW SUM — không sửa trực tiếp&lt;br&gt;Sổ xuống xem đóng góp từng khoa&lt;br&gt;Dải P50–P75 tính theo toàn viện" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2070" y="470" width="400" height="150" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;9 · PĐD hiệu chỉnh&lt;/b&gt;&lt;br&gt;Gõ TỔNG → hệ chia theo tỉ lệ đề xuất&lt;br&gt;PĐD sửa tay từng dòng được&lt;br&gt;Sửa sau khi khoa xác nhận: BẮT LÝ DO" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2520" y="470" width="350" height="150" as="geometry"/></mxCell><mxCell id="pq" value="&lt;b&gt;10 · CHỐT SỐ THAM GIA ĐẤU THẦU  →  Q&lt;/b&gt;&lt;br&gt;CỔNG CỨNG: chặn khi còn khoa ĐÃ GỬI mà chưa xác nhận bản hiện tại. Khoa chưa gửi gì thì KHÔNG tính.&lt;br&gt;Tạo snapshot Q bất biến theo (DOT_GOI × mã hàng × khoa) · Khoá phạm vi danh mục — không thêm mã nữa" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2070" y="700" width="800" height="155" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;11 · Ba giai đoạn đấu thầu&lt;/b&gt;&lt;br&gt;Chào giá → Mở thầu → Đánh giá&lt;br&gt;Phải xong giai đoạn trước mới sang sau&lt;br&gt;Mở lại: bắt lý do, giai đoạn sau hết hiệu lực" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1620" y="935" width="400" height="150" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Có ngoại lệ&lt;br&gt;rớt không?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7C2D12;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2130" y="945" width="220" height="130" as="geometry"/></mxCell><mxCell id="pwin" value="&lt;b&gt;MẶC ĐỊNH TRÚNG TOÀN BỘ&lt;/b&gt;&lt;br&gt;Không nhập gì → số trúng = Q, số rớt = 0&lt;br&gt;PĐD không phải tích trúng cho hàng nghìn mã" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2450" y="935" width="420" height="150" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;12 · Ngoại lệ rớt — cấp MÃ HÀNG&lt;/b&gt;&lt;br&gt;Nhập: giai đoạn · toàn bộ hay một phần · lý do&lt;br&gt;Rớt được ở nhiều giai đoạn: R1 + R2 + R3&lt;br&gt;KHOÁ CỨNG 3 — 0 ≤ ΣR ≤ Q" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1620" y="1170" width="400" height="160" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;13 · Phân bổ số trúng về khoa&lt;/b&gt;&lt;br&gt;Số trúng = Q − ΣR · Chỉ PĐD phân bổ&lt;br&gt;Trúng một phần → chia sẵn theo tỉ lệ Q&lt;br&gt;KHOÁ CỨNG 2 — tổng phân bổ = số trúng" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2070" y="1170" width="400" height="160" as="geometry"/></mxCell><mxCell id="pnote" value="&lt;b&gt;Chỉ khoa ĐÃ đề xuất mã đó&lt;/b&gt;&lt;br&gt;mới được nhận phân bổ.&lt;br&gt;Phân bổ vượt Q của một khoa:&lt;br&gt;được, nhưng phải nhập lý do." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2520" y="1170" width="350" height="160" as="geometry"/></mxCell><mxCell id="k6" value="&lt;b&gt;Mã rớt tự về khoa&lt;/b&gt;&lt;br&gt;PĐD bấm “Xác nhận rớt” → mã vào thẳng&lt;br&gt;đợt bổ sung T1/T5/T9 LUÔN MỞ SẴN của khoa&lt;br&gt;Số điền sẵn = số rớt · khoa sửa và QUYẾT CUỐI&lt;br&gt;Có thông báo đỏ + badge ở mục Gói bổ sung" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="1170" width="400" height="160" as="geometry"/></mxCell><mxCell id="k7" value="&lt;b&gt;Đề xuất bổ sung&lt;/b&gt;&lt;br&gt;KHÔNG áp P50–P95, không bắt lý do&lt;br&gt;Không bị chặn bởi số đã rớt&lt;br&gt;Hoặc chọn “Không còn nhu cầu”" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="595" y="1170" width="400" height="160" as="geometry"/></mxCell><mxCell id="p7" value="&lt;b&gt;14 · Chốt dữ liệu trình ký&lt;/b&gt;&lt;br&gt;Chốt từng bảng khoa → rồi chốt toàn bộ&lt;br&gt;QĐ 20/08: chỉ tính khoa ĐÃ GỬI đề xuất;&lt;br&gt;khoa im lặng ghi vào audit, KHÔNG chặn" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1620" y="1420" width="400" height="160" as="geometry"/></mxCell><mxCell id="p8" value="&lt;b&gt;15 · Revision &amp;amp; Excel chính thức&lt;/b&gt;&lt;br&gt;Khoá toàn bộ DOT_GOI, tạo revision&lt;br&gt;Excel khoa và Excel tổng hợp cùng revision&lt;br&gt;Số trên Excel cuối là SỐ TRÚNG đã phân bổ" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2070" y="1420" width="400" height="160" as="geometry"/></mxCell><mxCell id="preopen" value="&lt;b&gt;Mở lại&lt;/b&gt;&lt;br&gt;Mở một bảng khoa → bản tổng hợp&lt;br&gt;tự hết hiệu lực, revision cũ mất giá trị.&lt;br&gt;Mọi lần mở lại đều BẮT LÝ DO." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="2520" y="1420" width="350" height="160" as="geometry"/></mxCell><mxCell id="k8" value="&lt;b&gt;16 · Tuỳ chọn mua thêm 30%&lt;/b&gt;&lt;br&gt;CHỈ kích hoạt được SAU khi chốt trình ký&lt;br&gt;Trần = floor(số trúng của khoa × 30%)&lt;br&gt;Tính ở cấp khoa × mã quản lý" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="1420" width="400" height="160" as="geometry"/></mxCell><mxCell id="k9" value="&lt;b&gt;Mã hàng trở lại danh sách khoa&lt;/b&gt;&lt;br&gt;Sau khi chốt trình ký, mã hiện lại&lt;br&gt;cho kỳ đề xuất sau" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="595" y="1420" width="400" height="160" as="geometry"/></mxCell><mxCell id="outside" value="&lt;b&gt;NGOÀI PIPELINE — vẫn dùng, nhưng KHÔNG chặn bước nào của luồng trên&lt;/b&gt;&lt;br&gt;Sổ thiếu hàng (nguồn DUY NHẤT đo nhu cầu thật — HIS chỉ có lượng đã cấp khi còn hàng)  ·  Điều chỉnh tiêu chí kỹ thuật&lt;br&gt;Đề nghị mã kỹ thuật mới → PĐD duyệt  ·  Tiến độ sử dụng theo cam kết 20/50/80 (module sau khi hàng về)&lt;br&gt;⚠ Bốn màn này CHƯA được test lần nào — xem ../05_TRANG_THAI_VA_VIEC_TIEP_THEO.md" style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="1650" width="1270" height="175" as="geometry"/></mxCell><mxCell id="locks" value="&lt;b&gt;BA KHOÁ CỨNG — ngoài ba cái này, hệ CẢNH BÁO chứ không chặn&lt;/b&gt;&lt;br&gt;1 · Tổng mã hàng sau quy đổi = tổng mã quản lý        (lúc khoa phân bổ)&lt;br&gt;2 · Tổng phân bổ về các khoa = số trúng của mã          (lúc PĐD phân bổ kết quả)&lt;br&gt;3 · Tổng rớt ba giai đoạn ≤ số tham gia thầu (ΣR ≤ Q)   (lúc PĐD nhập ngoại lệ rớt)" style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7C2D12;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1620" y="1650" width="1250" height="175" as="geometry"/></mxCell><mxCell id="e-overview-1" value="mở đợt nhận đề xuất" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563EB;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p0" target="k1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k2" target="k3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-4" value="sinh danh mục" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0F766E;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k3" target="k4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="630"/><mxPoint x="1230" y="665"/><mxPoint x="350" y="665"/><mxPoint x="350" y="690"/></Array></mxGeometry></mxCell><mxCell id="e-overview-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k4" target="k5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k4" target="kword"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-7" value="đề xuất chính thức" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k3" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-8" value="trạng thái xác nhận" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k5" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-11" value="số đã ổn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p3" target="pq"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2695" y="630"/><mxPoint x="2695" y="665"/><mxPoint x="2470" y="665"/><mxPoint x="2470" y="690"/></Array></mxGeometry></mxCell><mxCell id="e-overview-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p2" target="pq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-13" value="Q đã đóng băng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="pq" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p4" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-15" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="d1" target="pwin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-16" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="d1" target="p5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2240" y="1075"/><mxPoint x="2240" y="1130"/><mxPoint x="1820" y="1130"/><mxPoint x="1820" y="1160"/></Array></mxGeometry></mxCell><mxCell id="e-overview-17" value="giữ nguyên phân bổ Q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="pwin" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-18" value="số trúng = Q − ΣR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-19" value="mã quản lý trúng 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p6" target="k6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k6" target="k7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-21" value="đi lại pipeline đầy đủ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k7" target="k3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1015" y="1250"/><mxPoint x="1120" y="1250"/><mxPoint x="1120" y="900"/><mxPoint x="1230" y="900"/><mxPoint x="1230" y="630"/></Array></mxGeometry></mxCell><mxCell id="e-overview-22" value="đã phân bổ hết" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p8" target="preopen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-25" value="mới bật được 30%" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p7" target="k8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-26" value="trả mã về khoa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0F766E;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="p7" target="k9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-overview-27" value="kỳ đề xuất sau" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="k9" target="p0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="995" y="1500"/><mxPoint x="1470" y="1500"/><mxPoint x="1470" y="240"/><mxPoint x="1820" y="240"/><mxPoint x="1820" y="275"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="khoa" name="02 Workflow Khoa chi tiết"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2260" pageHeight="2060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane-khoa-detail" value="KHOA / ĐVSD" style="swimlane;horizontal=1;startSize=54;rounded=1;arcSize=12;html=1;fillColor=#F0FDFA;swimlaneFillColor=#F0FDFA;strokeColor=#99F6E4;fontColor=#115E59;fontSize=18;fontStyle=1;strokeWidth=2;collapsible=0;pointerEvents=0;locked=1;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="2140" height="1690" as="geometry"/></mxCell><mxCell id="ks0" value="&lt;b&gt;Tín hiệu từ PĐD&lt;/b&gt;&lt;br&gt;Đợt đang MỞ và khoa có trong danh sách tham gia" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="275" width="420" height="110" as="geometry"/></mxCell><mxCell id="ks1" value="&lt;b&gt;1 · Chọn phạm vi&lt;/b&gt;&lt;br&gt;Loại mua sắm → đợt → gói con&lt;br&gt;18T có 5 gói con; bổ sung là gói phẳng" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="460" width="390" height="135" as="geometry"/></mxCell><mxCell id="ks2" value="&lt;b&gt;2 · Chọn mã quản lý&lt;/b&gt;&lt;br&gt;Chọn MỘT ĐVT chuẩn&lt;br&gt;Nhập hệ số cho các ĐVT còn lại&lt;br&gt;Trộn ĐVT mà thiếu hệ số → bị chặn" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="580" y="460" width="390" height="135" as="geometry"/></mxCell><mxCell id="ks3" value="&lt;b&gt;3 · Tham chiếu nhu cầu&lt;/b&gt;&lt;br&gt;Lịch sử 24 tháng + TSB&lt;br&gt;P50 · P75 · P90 · P95&lt;br&gt;P50 là mức CHỌN SẴN" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="460" width="390" height="135" as="geometry"/></mxCell><mxCell id="kd1" value="&lt;b&gt;Số nhập&lt;br&gt;&amp;gt; P75 ?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7C2D12;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="460" width="210" height="135" as="geometry"/></mxCell><mxCell id="ks4" value="&lt;b&gt;Có&lt;/b&gt;&lt;br&gt;Bắt buộc nhập lý do + ghi chú&lt;br&gt;Dưới P50 thì KHÔNG hỏi gì" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1780" y="460" width="340" height="135" as="geometry"/></mxCell><mxCell id="ks5" value="&lt;b&gt;4 · Chốt tổng mã quản lý&lt;/b&gt;&lt;br&gt;Chọn một mức, hoặc tự nhập&lt;br&gt;Số gợi ý KHÔNG tự điền vào ô&lt;br&gt;Snapshot quy đổi lưu cùng đề xuất" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="690" width="390" height="135" as="geometry"/></mxCell><mxCell id="ks6" value="&lt;b&gt;5 · Phân bổ xuống mã hàng&lt;/b&gt;&lt;br&gt;Chỉ số nguyên dương&lt;br&gt;Quy đổi từng mã về ĐVT chuẩn" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="580" y="690" width="390" height="135" as="geometry"/></mxCell><mxCell id="kd2" value="&lt;b&gt;KHOÁ CỨNG 1&lt;br&gt;tổng khớp?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7C2D12;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="690" width="240" height="135" as="geometry"/></mxCell><mxCell id="ks7" value="&lt;b&gt;6 · Thêm cả mã quản lý vào giỏ&lt;/b&gt;&lt;br&gt;Toàn bộ phân bổ trong MỘT transaction&lt;br&gt;Giỏ lưu server: sống qua F5, đăng xuất, máy khác&lt;br&gt;Mọi tài khoản cùng khoa thấy chung một giỏ" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="925" width="390" height="135" as="geometry"/></mxCell><mxCell id="ks8" value="&lt;b&gt;7 · Gửi giỏ = CHÍNH THỨC&lt;/b&gt;&lt;br&gt;1 giỏ = 1 gói con của tab đang đứng&lt;br&gt;KHÔNG có bước PĐD duyệt giỏ&lt;br&gt;Mã đã gửi bị ẩn khỏi danh sách của khoa" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="580" y="925" width="390" height="135" as="geometry"/></mxCell><mxCell id="ks9" value="&lt;b&gt;8 · Danh mục đề xuất của khoa&lt;/b&gt;&lt;br&gt;Sửa SỐ của khoa mình ngay tại đây&lt;br&gt;Cột CHỮ: sửa là ĐÈ CHO TOÀN VIỆN&lt;br&gt;giai_trinh_2627 là ngoại lệ, riêng theo khoa" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="925" width="390" height="135" as="geometry"/></mxCell><mxCell id="ks10" value="&lt;b&gt;Dải P50–P75 cạnh cột số&lt;/b&gt;&lt;br&gt;Dải bên khoa tính theo lịch sử CỦA KHOA&lt;br&gt;(bên PĐD tính theo toàn viện — nên hai bên khác nhau là đúng)&lt;br&gt;Vượt P75 chỉ TÔ NỔI BẬT, không chặn" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="925" width="620" height="135" as="geometry"/></mxCell><mxCell id="ks11" value="&lt;b&gt;9 · Xác nhận thông tin lần N&lt;/b&gt;&lt;br&gt;Thay cho “chốt danh mục” đã bỏ&lt;br&gt;Không khoá gì cả&lt;br&gt;Không giới hạn số lần bấm" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="1155" width="390" height="140" as="geometry"/></mxCell><mxCell id="ksNo" value="&lt;b&gt;Đường KHÔNG có nhu cầu&lt;/b&gt;&lt;br&gt;Xác nhận “Không phát sinh nhu cầu trong gói này”&lt;br&gt;Vẫn tính là đã phản hồi" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="1155" width="620" height="140" as="geometry"/></mxCell><mxCell id="kcancel" value="&lt;b&gt;Xác nhận TỰ HUỶ khi&lt;/b&gt;&lt;br&gt;bất kỳ ô nào của mã khoa đã đề xuất đổi —&lt;br&gt;kể cả do KHOA KHÁC sửa cột chữ chung.&lt;br&gt;Bấm lại thì lên lần N+1." style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#78350F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="580" y="1155" width="390" height="140" as="geometry"/></mxCell><mxCell id="kfreeze" value="&lt;b&gt;Khoa hết sửa khi nào&lt;/b&gt;&lt;br&gt;Chốt Q → khoá cột SỐ&lt;br&gt;Chốt trình ký → khoá cột CHỮ&lt;br&gt;Chỉ PĐD mở lại được, và phải nhập lý do" style="shape=note;size=18;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1155" width="390" height="140" as="geometry"/></mxCell><mxCell id="kd4" value="&lt;b&gt;Kết quả&lt;br&gt;mã quản lý?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7C2D12;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="1390" width="240" height="135" as="geometry"/></mxCell><mxCell id="ks14" value="&lt;b&gt;Trúng&lt;/b&gt;&lt;br&gt;Nhận phân bổ số trúng do PĐD chia&lt;br&gt;Khoa KHÔNG tự phân bổ" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="1390" width="390" height="135" as="geometry"/></mxCell><mxCell id="ks13" value="&lt;b&gt;Rớt → tự vào đợt bổ sung&lt;/b&gt;&lt;br&gt;Không còn khoảng chờ: mã nằm sẵn trong đợt&lt;br&gt;Trạng thái nay là “khoa đã xác nhận chưa”" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="580" y="1390" width="390" height="135" as="geometry"/></mxCell><mxCell id="ks15" value="&lt;b&gt;Xử lý phần rớt&lt;/b&gt;&lt;br&gt;Đề xuất lại ở đợt bổ sung&lt;br&gt;hoặc chọn “Không còn nhu cầu”&lt;br&gt;Vào giỏ nháp CHƯA tính là đã xử lý" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1390" width="390" height="135" as="geometry"/></mxCell><mxCell id="ks16" value="&lt;b&gt;10 · Mua thêm 30%&lt;/b&gt;&lt;br&gt;Chỉ bật SAU khi PĐD chốt trình ký&lt;br&gt;Trần = floor(số trúng của khoa × 30%)&lt;br&gt;Cấp khoa × mã quản lý; tổng các lần ≤ trần" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14532D;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="1620" width="390" height="140" as="geometry"/></mxCell><mxCell id="ks17" value="&lt;b&gt;Luồng hỗ trợ — ngoài pipeline&lt;/b&gt;&lt;br&gt;Sổ thiếu hàng · Đề nghị mã kỹ thuật mới&lt;br&gt;Đề nghị sửa tiêu chí kỹ thuật → PĐD duyệt&lt;br&gt;Không chặn bất kỳ bước nào ở trên" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#134E4A;fillColor=#E6FFFB;strokeColor=#0F766E;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="1620" width="620" height="140" as="geometry"/></mxCell><mxCell id="kbosung" value="&lt;b&gt;Đề xuất bổ sung&lt;/b&gt;&lt;br&gt;KHÔNG áp P50–P95, không bắt lý do vượt ngưỡng&lt;br&gt;Không bị giới hạn bởi số đã rớt&lt;br&gt;Vẫn kiểm: số nguyên dương · ĐVT · tổng khớp" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#4C1D95;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="580" y="1620" width="390" height="140" as="geometry"/></mxCell><mxCell id="e-khoa-1" value="đợt mở" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563EB;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks0" target="ks1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;dashed=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" parent="1" source="ks1" target="ks2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-khoa-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endAr